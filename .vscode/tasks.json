{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Play Browser",
            "type": "shell",
            "command": "echo Browser Opened",
            "args": [
                "${input:openPlayBrowser}"
            ],
            "problemMatcher": []
        },
        {
            "label": "Preprocess Browser",
            "type": "shell",
            "command": "echo Browser Opened",
            "args": [
                "${input:openProcessBrowser}"
            ],
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "openPlayBrowser",
            "type": "command",
            "command": "simpleBrowser.show",
            "args": [
                "http://localhost:8085"
            ]
        },
        {
            "id": "openProcessBrowser",
            "type": "command",
            "command": "simpleBrowser.show",
            "args": [
                "http://localhost:8080"
            ]
        }
    ]
}
