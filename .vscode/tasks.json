{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Retarget LAFAN1 sample to G1",
            "type": "process",
            "command": "uv",
            "args": [
                "run", "--extra", "fast", "--extra", "cli", "frdv-retarget",
                "robot=g1", "data=assets/mocap/sample/walk3_subject5.bvh", "out=outputs/sample_g1"
            ],
            "problemMatcher": []
        },
        {
            "label": "View retargeted sample",
            "type": "process",
            "command": "uv",
            "args": ["run", "--extra", "cli", "--extra", "vis", "frdv-view", "outputs/sample_g1"],
            "problemMatcher": []
        }
    ]
}
